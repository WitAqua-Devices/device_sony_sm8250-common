// LTALabel model detection, shared with the per-device libinits.
cc_library_static {
    name: "libinit_sku_sm8250",
    srcs: ["sku.cpp"],
    recovery_available: true,
    header_libs: ["libbase_headers"],
    export_include_dirs: ["."],
    visibility: [
        "//device/sony/sm8250-common:__subpackages__",
        "//device/sony/pdx203:__subpackages__",
        "//device/sony/pdx206:__subpackages__",
    ],
}

cc_library_static {
    name: "libinit_sm8250",
    srcs: ["init_sm8250.cpp"],
    recovery_available: true,
    header_libs: ["libbase_headers"],
    whole_static_libs: ["libinit_sku_sm8250"],
}
